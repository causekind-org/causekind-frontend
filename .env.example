# CauseKind frontend — public environment variables.
#
# Everything here is NEXT_PUBLIC_*, which means it is inlined into the browser
# bundle and is readable by anyone using the site. Nothing secret belongs in this
# file or in .env.local. Server-side secrets live in the backend's own .env.
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.

# Backend origin. Leave unset to use the same origin as the frontend.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Sign-In client id (OAuth 2.0 Web application credential).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Google Maps ───────────────────────────────────────────────────────────────
# Used by the handover "exact meeting spot" pin picker. The picker degrades to a
# neutral note plus the "Use my location" button when these are missing or the
# key is rejected, so the handover flow still works without them.
#
# An InvalidKeyMapError in the console means the key exists but Google refused
# it. Check, in this order:
#   1. Billing is enabled on the Cloud project (most common cause).
#   2. "Maps JavaScript API" is enabled — separate from the other Maps APIs.
#   3. HTTP referrer restrictions include your origin, e.g. http://localhost:3000/*
#
# Restrict this key by HTTP referrer. It is public by design, but an unrestricted
# key can be used by anyone and billed to you.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID from Cloud console → Maps → Map Management, rendering type **Vector**.
# Advanced markers require a vector Map ID. Defaults to Google's DEMO_MAP_ID,
# which is fine locally but is not intended for production.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Analytics (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
